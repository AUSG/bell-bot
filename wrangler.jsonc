{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bell-bot",
  "account_id": "dec3126a149bbaf5bf156247070a802d",
  "main": "src/index.ts",
  // Latest date supported by the workerd version bundled with Wrangler 4.124.0.
  "compatibility_date": "2026-08-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bell",
      "database_id": "43136dd0-5f96-45a6-b05a-6c9c681233a4",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": ["SLACK_BOT_TOKEN", "SLACK_SIGNING_SECRET"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
